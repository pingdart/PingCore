PRODUCT_NAME = PingCore Examples
PRODUCT_BUNDLE_IDENTIFIER = com.pingcore.examples
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 15.0
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGN_STYLE = Automatic
CLANG_CXX_LANGUAGE_STANDARD = c++20
ENABLE_BITCODE = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

PINGCORE_PROJECT_ROOT = $(PROJECT_DIR)/../../..
PINGCORE_CORE_BUILD_DIR = $(DERIVED_FILE_DIR)/pingcore-core
PINGCORE_APP_TARGET = example_ui_gallery
PINGCORE_APP_INFO_PLIST = App/Info.plist
PINGCORE_NOTIFICATION_BUNDLE_IDENTIFIER = com.pingcore.examples.localnotification
PINGCORE_LINK_OPTIONS_FILE = $(PINGCORE_CORE_BUILD_DIR)/pingcore-ios/$(PINGCORE_APP_TARGET)/link.rsp
HEADER_SEARCH_PATHS = $(inherited) "$(PINGCORE_PROJECT_ROOT)/include"
OTHER_LDFLAGS = $(inherited) @"$(PINGCORE_LINK_OPTIONS_FILE)"

#include? "Local.xcconfig"
