// The integration the CLI last built this shell with and the framework it resolved, so a build from Xcode itself
// matches the CLI's; Local.xcconfig, included last, overrides them.
#include? "../../../.pingcore/generated/ios/integration.xcconfig"

PRODUCT_NAME = @PROJECT_NAME@
PRODUCT_BUNDLE_IDENTIFIER = @PROJECT_ID@
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 15.0
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGN_STYLE = Automatic
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CLANG_CXX_LANGUAGE_STANDARD = c++20
ENABLE_BITCODE = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO

PINGCORE_PROJECT_ROOT = $(PROJECT_DIR)/../..
PINGCORE_OPTIMIZATION = default
PINGCORE_ENABLE_LTO = OFF
PINGCORE_CORE_BUILD_DIR = $(DERIVED_FILE_DIR)/pingcore-core
PINGCORE_LINK_OPTIONS_FILE = $(PINGCORE_CORE_BUILD_DIR)/pingcore-ios/@TARGET_NAME@/link.rsp
HEADER_SEARCH_PATHS = $(inherited) "$(PINGCORE_HOME)/include"
OTHER_LDFLAGS = $(inherited) @"$(PINGCORE_LINK_OPTIONS_FILE)"

#include? "Local.xcconfig"

#include? "Local.xcconfig"
