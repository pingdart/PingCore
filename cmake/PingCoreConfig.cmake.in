@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)

if(APPLE)
    find_library(SECURITY_FRAMEWORK Security REQUIRED)
endif()

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/PingCoreTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/PingCoreTargets.cmake")
endif()

check_required_components(PingCore)
