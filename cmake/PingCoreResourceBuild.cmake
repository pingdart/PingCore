foreach (required_variable IN ITEMS
        PINGCORE_HRC PINGCORE_RESOURCE_OUTPUT
)
    if (NOT DEFINED ${required_variable} OR "${${required_variable}}" STREQUAL "")
        message(FATAL_ERROR "${required_variable} is required")
    endif ()
endforeach ()

foreach (optional_variable IN ITEMS
        PINGCORE_RESOURCE_PACKAGE_INPUTS PINGCORE_RESOURCE_ROOTS PINGCORE_RESOURCE_NAMESPACES
)
    if (NOT DEFINED ${optional_variable})
        set(${optional_variable})
    endif ()
endforeach ()

list(LENGTH PINGCORE_RESOURCE_ROOTS PINGCORE_RESOURCE_ROOT_COUNT)
list(LENGTH PINGCORE_RESOURCE_NAMESPACES PINGCORE_RESOURCE_NAMESPACE_COUNT)
if (NOT PINGCORE_RESOURCE_ROOT_COUNT EQUAL PINGCORE_RESOURCE_NAMESPACE_COUNT)
    message(FATAL_ERROR "PingCore resource roots and namespaces must have matching counts")
endif ()
if (NOT PINGCORE_RESOURCE_PACKAGE_INPUTS AND NOT PINGCORE_RESOURCE_ROOTS)
    message(FATAL_ERROR "PingCore resource merge requires at least one package or root")
endif ()

set(PINGCORE_RESOURCE_WORK_DIRECTORY "${PINGCORE_RESOURCE_OUTPUT}/roots")
file(REMOVE_RECURSE "${PINGCORE_RESOURCE_WORK_DIRECTORY}")

set(PINGCORE_RESOURCE_MERGE_COMMAND "${PINGCORE_HRC}" merge)
foreach (PINGCORE_RESOURCE_PACKAGE IN LISTS PINGCORE_RESOURCE_PACKAGE_INPUTS)
    list(APPEND PINGCORE_RESOURCE_MERGE_COMMAND
            --input "${PINGCORE_RESOURCE_PACKAGE}"
    )
endforeach ()

set(PINGCORE_RESOURCE_ROOT_INDEX 0)
while (PINGCORE_RESOURCE_ROOTS)
    list(POP_FRONT PINGCORE_RESOURCE_ROOTS PINGCORE_RESOURCE_ROOT)
    list(POP_FRONT PINGCORE_RESOURCE_NAMESPACES PINGCORE_RESOURCE_NAMESPACE)
    set(PINGCORE_RESOURCE_ROOT_OUTPUT
            "${PINGCORE_RESOURCE_WORK_DIRECTORY}/${PINGCORE_RESOURCE_ROOT_INDEX}"
    )
    execute_process(
            COMMAND "${PINGCORE_HRC}"
                    --root "${PINGCORE_RESOURCE_ROOT}"
                    --output "${PINGCORE_RESOURCE_ROOT_OUTPUT}"
                    --namespace "${PINGCORE_RESOURCE_NAMESPACE}"
            COMMAND_ERROR_IS_FATAL ANY
    )
    list(APPEND PINGCORE_RESOURCE_MERGE_COMMAND
            --input "${PINGCORE_RESOURCE_ROOT_OUTPUT}/package"
    )
    math(EXPR PINGCORE_RESOURCE_ROOT_INDEX
            "${PINGCORE_RESOURCE_ROOT_INDEX} + 1"
    )
endwhile ()

list(APPEND PINGCORE_RESOURCE_MERGE_COMMAND
        --output "${PINGCORE_RESOURCE_OUTPUT}"
)
execute_process(
        COMMAND ${PINGCORE_RESOURCE_MERGE_COMMAND}
        COMMAND_ERROR_IS_FATAL ANY
)
file(REMOVE_RECURSE "${PINGCORE_RESOURCE_WORK_DIRECTORY}")
